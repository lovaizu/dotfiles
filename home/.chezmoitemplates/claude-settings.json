{
  "permissions": {
    "additionalDirectories": [
      "~/.claude/plugins/cache"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"$HOME/.claude/scripts/statusline.sh\""
  },
  "outputStyle": "Concise",
  "tui": "fullscreen",
  "theme": "auto",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/scripts/prose/check-command.sh\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/scripts/rm/check-command.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/scripts/prose/check-file.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
