{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail
{{ template "warn.sh" . }}
CMD_EIKANA_TAP="dominion525/tap"
CMD_EIKANA_CASK="$CMD_EIKANA_TAP/cmd-eikana"
CMD_EIKANA_BUNDLE_ID="io.github.dominion525.cmd-eikana"

# Prints the process ID of every process holding an enabled Quartz event
# tap, one per line. CGEventTapInformation is 48 bytes, or 12 uint32s.
# tappingProcess is the seventh uint32, and the enabled bool is the low byte
# of the ninth. A measurement on arm64 and macOS 26 gave these offsets.
event_tap_owners() {
  osascript -l JavaScript \
    -e 'ObjC.import("CoreGraphics"); ObjC.import("Foundation");' \
    -e 'ObjC.bindFunction("CGGetEventTapList", ["int", ["unsigned int", "void *", "unsigned int *"]]);' \
    -e 'var n = Ref("unsigned int"); $.CGGetEventTapList(0, null, n);' \
    -e 'var d = $.NSMutableData.dataWithLength(48 * n[0]); $.CGGetEventTapList(n[0], d.mutableBytes, n);' \
    -e 'd.base64EncodedStringWithOptions(0).js' |
    base64 -d | od -v -A n -t u4 | tr -s ' ' '\n' | sed '/^$/d' |
    awk 'NR % 12 == 7 { pid = $0 } NR % 12 == 9 && $0 % 256 != 0 { print pid }'
}

# The original cask shares the token. A measurement showed that `brew list
# --cask` with either name succeeds for both. Only the install receipt
# distinguishes the two casks.
cmd_eikana_installed_tap() {
  local receipt
  receipt="$(brew --prefix)/Caskroom/cmd-eikana/.metadata/INSTALL_RECEIPT.json"
  [ -f "$receipt" ] || return 0
  grep -o '"tap": *"[^"]*"' "$receipt" | head -n 1 | cut -d '"' -f 4
}

# The app selects the input source, so this script checks that the app
# holds a key tap, instead of checking that it's installed. The app creates
# the tap only after the user grants it keyboard access. A script can't grant
# that access, and it can't read the access back either. The terminal can't
# read the Transparency, Consent, and Control (TCC) database without Full
# Disk Access. A measurement showed this.
realize_cmd_eikana() {
  local cost=(
    "Until this is fixed, left and right ⌘ alone do nothing, and the only"
    "way to switch input is the fn (globe) key."
  )
  if ! command -v brew &>/dev/null; then
    warn "Homebrew isn't installed, so ⌘英かな wasn't installed either." \
      "${cost[@]}" \
      "Fix: install Homebrew and re-run chezmoi apply."
    return 1
  fi
  local installed_tap
  installed_tap="$(cmd_eikana_installed_tap)"
  if [ "$installed_tap" = "$CMD_EIKANA_TAP" ]; then
    echo "⌘英かな already installed. Skipping."
  elif [ -n "$installed_tap" ]; then
    # Not replaced here: uninstalling an app the user put in is their call.
    warn "This Mac has the original cmd-eikana cask, not the Apple Silicon fork." \
      "The original runs under Rosetta and hangs on macOS 26." \
      "Fix: brew uninstall --cask cmd-eikana, then re-run chezmoi apply."
    return 1
  # Current Homebrew refuses a cask from a tap that was never tapped,
  # as measured, so the tap comes first.
  elif ! brew tap "$CMD_EIKANA_TAP" || ! brew install --cask "$CMD_EIKANA_CASK"; then
    warn "brew install --cask $CMD_EIKANA_CASK failed." \
      "brew said why in the preceding output." \
      "${cost[@]}" \
      "Fix: once that reason no longer applies, re-run chezmoi apply."
    return 1
  fi

  # First launch is what registers it as a login item and asks for the
  # permissions. Later launches come from that login item. The `pgrep` below
  # catches a failed open, with its own message.
  if ! pgrep -f "/⌘英かな.app/Contents/MacOS/" >/dev/null; then
    open -b "$CMD_EIKANA_BUNDLE_ID" || true
    sleep 2
  fi
  local pid
  pid="$(pgrep -f "/⌘英かな.app/Contents/MacOS/" | head -n 1 || true)"
  if [ -z "$pid" ]; then
    warn "⌘英かな didn't start." \
      "${cost[@]}" \
      "Fix: open ⌘英かな from Applications to see why, then re-run chezmoi apply."
    return 1
  fi
  local owners
  if ! owners="$(event_tap_owners)"; then
    warn "Couldn't list the keyboard event taps to check on ⌘英かな." \
      "osascript said why in the preceding output." \
      "Fix: once that reason no longer applies, re-run chezmoi apply."
    return 1
  fi
  if ! grep -qx "$pid" <<<"$owners"; then
    warn "⌘英かな is running but can't see the keyboard yet." \
      "Only you can grant this. ⌘英かな asks on its own and opens System Settings." \
      "Under Privacy & Security, turn it on in both Input Monitoring and Accessibility." \
      "It picks up the grant without a restart." \
      "${cost[@]}" \
      "Fix: grant both, then re-run chezmoi apply."
    return 1
  fi
  echo "⌘英かな is running with keyboard access."
}

realize_cmd_eikana
{{ end -}}
