{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Runs before chezmoi places the files, so the steps after them find herdr
# and jq. Re-runs only when this list changes, or after a run that failed.
set -euo pipefail
{{ template "warn.sh" . }}
if ! command -v brew &>/dev/null; then
  warn "Homebrew isn't installed, so herdr, jq, starship, sbx and the HackGen font weren't installed." \
    "Fix: install Homebrew, then re-run chezmoi apply."
  exit 1
fi
# Docker's install steps trust its tap before installing sbx from it.
if ! brew trust --tap docker/tap; then
  warn "brew trust --tap docker/tap failed, so sbx wasn't installed." \
    "brew said why in the preceding output." \
    "Fix: once that reason no longer applies, re-run chezmoi apply."
  exit 1
fi
# --no-upgrade: updating what is already there is brew's job, not this one.
if ! brew bundle --no-upgrade --file=/dev/stdin <<'EOF'; then
tap "docker/tap"
brew "herdr"
brew "jq"
brew "starship"
cask "docker/tap/sbx"
cask "font-hackgen-nerd"
EOF
  warn "brew bundle didn't install everything." \
    "brew said why in the preceding output." \
    "Fix: once that reason no longer applies, re-run chezmoi apply."
  exit 1
fi
{{ end -}}
