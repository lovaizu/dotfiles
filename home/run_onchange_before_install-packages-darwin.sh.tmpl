{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Runs before the files are placed, so the steps after them find herdr and
# jq. Re-runs only when this list changes, or after a run that failed.
set -euo pipefail
{{ template "warn.sh" . }}
if ! command -v brew &>/dev/null; then
  warn "Homebrew is not installed, so herdr, jq, starship and the HackGen font were not installed." \
    "Fix: install Homebrew, then re-run chezmoi apply."
  exit 1
fi
# --no-upgrade: updating what is already there is brew's job, not this one.
if ! brew bundle --no-upgrade --file=/dev/stdin <<'EOF'; then
brew "herdr"
brew "jq"
brew "starship"
cask "font-hackgen-nerd"
EOF
  warn "brew bundle did not install everything." \
    "brew said why just above." \
    "Fix: once the reason is gone, re-run chezmoi apply."
  exit 1
fi
{{ end -}}
