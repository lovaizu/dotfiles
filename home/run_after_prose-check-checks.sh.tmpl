#!/bin/bash
# Fetches the commit of lovaizu/checks that the hooks of the plugin
# prose-check run, and installs the tools of its checks with its setup.sh.
# plugins/prose-check/hooks/checks.sh pins the commit and names the
# directory. git checks the content against the hash of the commit.
set -euo pipefail
{{ template "warn.sh" . }}
. {{ joinPath .chezmoi.workingTree "plugins/prose-check/hooks/checks.sh" | quote }}

if [ ! -d "$checks_dir" ]; then
  mkdir -p "$(dirname "$checks_dir")"
  part="$(mktemp -d "$checks_dir.XXXXXX")"
  trap 'rm -rf "$part"' EXIT
  if ! git -C "$part" init -q ||
    ! git -C "$part" fetch -q --depth 1 "$checks_url" "$checks_sha" ||
    ! git -C "$part" checkout -q FETCH_HEAD; then
    warn "git didn't fetch commit $checks_sha of $checks_url, so the hooks of prose-check can't check the prose." \
      "git said why in the preceding output." \
      "Fix: once that reason no longer applies, re-run chezmoi apply."
    exit 1
  fi
  mv "$part" "$checks_dir"
  trap - EXIT
fi

if ! "$checks_dir/setup.sh"; then
  warn "The setup.sh of lovaizu/checks didn't install the tools of the checks, so the hooks of prose-check can't check the prose." \
    "It said why in the preceding output." \
    "Fix: once that reason no longer applies, re-run chezmoi apply."
  exit 1
fi
