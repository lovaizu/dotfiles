#!/bin/bash
# The marketplace and plugins are named here, not in settings.json: Claude
# Code writes enabledPlugins back into the live file once a plugin is
# installed, so a copy in the repo would be runtime state, not configuration.
set -euo pipefail
{{ template "warn.sh" . }}
marketplace_name="ccpm"
marketplace_repo="lovaizu/ccpm"
# rn does not work while it is rebuilt (lovaizu/ccpm#54), and writ comes in
# with it. turn is not used until then either. Leaving them out of
# install_ids is not enough: a machine that already has them keeps them, so
# they are removed too. Once the rebuilt rn lands, it and turn go in
# install_ids and writ stays in remove_ids.
install_ids=()
remove_ids=("rn@ccpm" "writ@ccpm" "turn@ccpm")

for cmd in claude jq; do
  if ! command -v "$cmd" &>/dev/null; then
    warn "$cmd is missing, so the plugins from the $marketplace_name marketplace were not set up." \
      "Fix: install $cmd, then re-run chezmoi apply."
    exit 1
  fi
done

# Checked before calling `uninstall`: it fails on a plugin that is not there.
installed_now="$(claude plugin list --json)"
for plugin_id in "${remove_ids[@]}"; do
  if echo "$installed_now" | jq -e --arg id "$plugin_id" '.[] | select(.id == $id)' >/dev/null; then
    if ! claude plugin uninstall "$plugin_id"; then
      warn "Plugin $plugin_id was not uninstalled." \
        "\`claude plugin uninstall\` said why just above." \
        "Fix: once the reason above is gone, re-run chezmoi apply."
      exit 1
    fi
  fi
done

if [ "${#install_ids[@]}" -eq 0 ]; then
  exit 0
fi

# Checked before calling `add` rather than trusting it to be safe to repeat:
# `add` re-clones the marketplace repo.
marketplaces_now="$(claude plugin marketplace list --json 2>/dev/null || echo '[]')"
if ! echo "$marketplaces_now" | jq -e --arg n "$marketplace_name" '.[] | select(.name == $n)' >/dev/null; then
  if ! claude plugin marketplace add "$marketplace_repo"; then
    warn "Marketplace $marketplace_name ($marketplace_repo) was not added." \
      "\`claude plugin marketplace add\` said why just above, and the" \
      "plugins from it could not be installed either." \
      "Fix: once the reason above is gone, re-run chezmoi apply."
    exit 1
  fi
fi

# Measured idempotent (two real runs, same end state). -y answers the
# install's own prompt so a run never sits waiting for input.
for plugin_id in "${install_ids[@]}"; do
  if ! claude plugin install "$plugin_id" -y; then
    warn "Plugin $plugin_id was not installed." \
      "\`claude plugin install\` said why just above." \
      "Fix: once the reason above is gone, re-run chezmoi apply."
    exit 1
  fi
done
