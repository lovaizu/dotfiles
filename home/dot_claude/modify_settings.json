{{- /* chezmoi:modify-template */ -}}
{{- /*
  Claude Code writes `enabledPlugins` back into this file, and herdr writes
  `hooks.SessionStart`, so the template sets only the keys kept in the
  repo and leaves the rest as found.
  A key dropped from the repo stays on the machine until removed here.
*/ -}}
{{- $live := dict -}}
{{- if .chezmoi.stdin -}}{{- $live = fromJson .chezmoi.stdin -}}{{- end -}}
{{- $merged := mergeOverwrite (deepCopy $live) (include ".chezmoitemplates/claude-settings.json" | fromJson) -}}
{{- /*
  The hook of the prose check moved to lovaizu/repofiles, whose setup.sh
  puts it into each repository. The repo no longer has PostToolUse, so its
  entry stays in the live file unless removed here.
*/ -}}
{{- with $merged.hooks -}}
{{- if hasKey . "PostToolUse" -}}
{{- $kept := list -}}
{{- range .PostToolUse -}}
{{- if not (contains "/.claude/scripts/prose/" (toJson .)) -}}{{- $kept = append $kept . -}}{{- end -}}
{{- end -}}
{{- if $kept -}}{{- $_ := set . "PostToolUse" $kept -}}{{- else -}}{{- $_ := unset . "PostToolUse" -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- /* Left byte for byte when nothing changes: rewriting only reorders keys. */ -}}
{{- if eq (toJson $merged) (toJson $live) -}}
{{- .chezmoi.stdin -}}
{{- else -}}
{{- $merged | toPrettyJson -}}
{{- end -}}
