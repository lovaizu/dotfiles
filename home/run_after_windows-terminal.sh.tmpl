{{- if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
#!/bin/bash
# Windows Terminal reads its settings from the Windows side, outside the
# Windows Subsystem for Linux (WSL) home that chezmoi manages, so this script
# copies this one file instead.
set -euo pipefail
{{ template "warn.sh" . }}
src={{ joinPath .chezmoi.sourceDir ".chezmoitemplates/windows-terminal-settings.json" | quote }}

# [interop] appendWindowsPath=false hides cmd.exe from PATH, so its absence
# says nothing about whether this is WSL -- the kernel already said so.
if ! command -v wslpath &>/dev/null || ! command -v cmd.exe &>/dev/null; then
  warn "Windows Terminal's settings.json wasn't copied." \
    "wslpath or cmd.exe is missing, so this script can't work out from here" \
    "where Windows keeps this user's AppData. The usual reason is interop:" \
    "[interop] appendWindowsPath=false in /etc/wsl.conf keeps cmd.exe off" \
    "PATH, and [interop] enabled=false stops Windows binaries running at" \
    "all. This script wrote nothing anywhere." \
    "Fix: run this from a shell that has cmd.exe on PATH, or turn interop" \
    "back on in /etc/wsl.conf and apply it with wsl --shutdown, then" \
    "re-run chezmoi apply."
  exit 1
fi

# cd: cmd.exe can't start in a WSL directory, which is a network path to
# Windows, and says so in the console's code page, which WSL shows garbled.
appdata="$(cd /mnt/c && cmd.exe /c 'echo %LOCALAPPDATA%' | tr -d '\r' || true)"
if [ -n "$appdata" ]; then
  appdata="$(wslpath "$appdata" || echo "$appdata")"
fi
# Must come back absolute: cmd.exe echoes an unset variable back as the
# literal %LOCALAPPDATA%, as measured.
case "$appdata" in
  /*) ;;
  *)
    warn "Windows Terminal's settings.json wasn't copied." \
      "%LOCALAPPDATA% didn't resolve to a path. The answer was:" \
      "  ${appdata:-(nothing at all)}" \
      "Whatever cmd.exe or wslpath said about it appears in the preceding output." \
      "This script wrote nothing anywhere." \
      "Fix: check that \`cd /mnt/c && cmd.exe /c 'echo %LOCALAPPDATA%'\`" \
      "answers from this shell, then re-run chezmoi apply."
    exit 1
    ;;
esac

wt_dir="$appdata/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState"
dst="$wt_dir/settings.json"
# LocalState is an installed package's footprint, not a drop box, so this
# script never creates it.
if [ ! -d "$wt_dir" ]; then
  echo "Windows Terminal isn't installed: $wt_dir doesn't exist. Skipping." >&2
  exit 0
fi
if cmp -s "$src" "$dst"; then
  exit 0
fi
# The whole file replaces the old one. It holds the WSL profiles of the one
# Windows machine in use, so on another machine it would replace that
# machine's own profiles with these.
# Renamed into place only once whole, so a stop midway leaves the old file.
tmp="$wt_dir/.settings.json.dotfiles-tmp.$$"
trap 'rm -f "$tmp"' EXIT
if ! cp "$src" "$tmp" || ! mv -f "$tmp" "$dst"; then
  warn "Windows Terminal's settings.json wasn't copied." \
    "The command that failed said why in the preceding output. The file is as it was." \
    "Fix: once that reason no longer applies, re-run chezmoi apply."
  exit 1
fi
echo "Installed $dst"
{{ end -}}
