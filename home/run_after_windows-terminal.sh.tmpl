{{- if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
#!/bin/bash
# Windows Terminal reads its settings from the Windows side, outside the
# WSL home chezmoi manages, so this one file is copied here instead.
set -euo pipefail
{{ template "warn.sh" . }}
src={{ joinPath .chezmoi.sourceDir ".chezmoitemplates/windows-terminal-settings.json" | quote }}

# [interop] appendWindowsPath=false hides cmd.exe from PATH, so its absence
# says nothing about whether this is WSL -- the kernel already said so.
if ! command -v wslpath &>/dev/null || ! command -v cmd.exe &>/dev/null; then
  warn "Windows Terminal's settings.json was not copied." \
    "wslpath or cmd.exe is missing, so where Windows keeps this user's" \
    "AppData cannot be worked out from here. The usual reason is interop:" \
    "[interop] appendWindowsPath=false in /etc/wsl.conf keeps cmd.exe off" \
    "PATH, and [interop] enabled=false stops Windows binaries running at" \
    "all. Nothing was written anywhere." \
    "Fix: run this from a shell that has cmd.exe on PATH, or turn interop" \
    "back on in /etc/wsl.conf (it takes a wsl --shutdown to apply), then" \
    "re-run chezmoi apply."
  exit 1
fi

appdata="$(cmd.exe /c 'echo %LOCALAPPDATA%' | tr -d '\r' || true)"
if [ -n "$appdata" ]; then
  appdata="$(wslpath "$appdata" || echo "$appdata")"
fi
# Must come back absolute: cmd.exe echoes an unset variable back as the
# literal %LOCALAPPDATA% (measured).
case "$appdata" in
  /*) ;;
  *)
    warn "Windows Terminal's settings.json was not copied." \
      "%LOCALAPPDATA% did not resolve to a path. The answer was:" \
      "  ${appdata:-(nothing at all)}" \
      "Whatever cmd.exe or wslpath said about it is just above. Nothing was" \
      "written anywhere." \
      "Fix: check that \`cmd.exe /c 'echo %LOCALAPPDATA%'\` answers from" \
      "this shell (a cwd on a UNC path is the usual reason it does not)."
    exit 1
    ;;
esac

wt_dir="$appdata/Packages/Microsoft.WindowsTerminal_8wekyb3d8bbwe/LocalState"
dst="$wt_dir/settings.json"
# LocalState is an installed package's footprint, not a drop box, so it is
# never created here.
if [ ! -d "$wt_dir" ]; then
  echo "Windows Terminal not installed ($wt_dir does not exist). Skipping." >&2
  exit 0
fi
if cmp -s "$src" "$dst"; then
  exit 0
fi
# Renamed into place only once whole, so a stop midway leaves the old file.
tmp="$wt_dir/.settings.json.dotfiles-tmp.$$"
trap 'rm -f "$tmp"' EXIT
if ! cp "$src" "$tmp" || ! mv -f "$tmp" "$dst"; then
  warn "Windows Terminal's settings.json was not copied." \
    "The command that failed said why just above. The file is as it was." \
    "Fix: once the reason is gone, re-run chezmoi apply."
  exit 1
fi
echo "Installed $dst"
{{ end -}}
