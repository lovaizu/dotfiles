{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Runs before the files are placed, so the steps after them find herdr and
# jq. Re-runs only when this script changes, or after a run that failed.
set -euo pipefail
{{ template "warn.sh" . }}
failed=""

if command -v herdr &>/dev/null; then
  echo "herdr already installed. Skipping."
# The official installer: no root, checks the binary's SHA-256, puts it in
# ~/.local/bin (read, 2026-10-08).
elif ! curl -fsSL https://herdr.dev/install.sh | sh; then
  warn "herdr's installer failed." \
    "It said why just above." \
    "Fix: once the reason is gone, re-run chezmoi apply."
  failed=1
fi

if command -v jq &>/dev/null; then
  echo "jq already installed. Skipping."
# apt over a downloaded binary so apt upgrade keeps it current; the cost is
# a sudo password prompt during the run.
elif ! command -v apt-get &>/dev/null; then
  warn "apt-get is not available, so jq was not installed." \
    "Fix: install jq with this system's package manager, then re-run chezmoi apply."
  failed=1
elif ! sudo apt-get install -y jq; then
  warn "sudo apt-get install -y jq failed." \
    "It said why just above (sudo needs a terminal to ask for the password)." \
    "Fix: once the reason is gone, re-run chezmoi apply."
  failed=1
fi

if command -v starship &>/dev/null; then
  echo "starship already installed. Skipping."
# The official installer into ~/.local/bin, beside herdr: its default
# /usr/local/bin needs sudo (read, 2026-10-18).
elif ! mkdir -p "$HOME/.local/bin" ||
  ! curl -fsSL https://starship.rs/install.sh | sh -s -- -y -b "$HOME/.local/bin"; then
  warn "starship's installer failed." \
    "It said why just above." \
    "Fix: once the reason is gone, re-run chezmoi apply."
  failed=1
fi

{{- if .chezmoi.kernel.osrelease | lower | contains "microsoft" }}

# sb drives the Windows sbx through interop, so it goes in on the Windows
# side. winget puts it in the user's own AppData without asking for admin.
if command -v sbx.exe &>/dev/null; then
  echo "sbx.exe already installed. Skipping."
elif ! command -v winget.exe &>/dev/null || ! command -v powershell.exe &>/dev/null; then
  warn "winget.exe or powershell.exe is not found, so sbx (Docker Sandboxes) was not installed." \
    "The usual reason is that WSL does not see Windows' PATH" \
    "([interop] appendWindowsPath=false in /etc/wsl.conf)." \
    "Fix: once both are found from this shell, re-run chezmoi apply."
  failed=1
# winget answers non-zero when the package is already there, so ask first.
# cd: Windows programs cannot start in a WSL directory (a UNC path to Windows).
elif ! (cd /mnt/c && winget.exe list --id Docker.sbx --exact --accept-source-agreements &>/dev/null) &&
  ! (cd /mnt/c && winget.exe install -h --id Docker.sbx --exact --accept-source-agreements --accept-package-agreements); then
  warn "winget install Docker.sbx failed." \
    "It said why just above." \
    "Fix: once the reason is gone, re-run chezmoi apply."
  failed=1
else
  # winget adds sbx to Windows' PATH, which WSL reads only when it starts,
  # so a link beside herdr makes it found now. Windows' PATH is read afresh
  # from the registry rather than from this shell's copy.
  sbx_win="$(cd /mnt/c && powershell.exe -NoProfile -Command '
    $p = [Environment]::GetEnvironmentVariable("Path", "User") + ";" +
      [Environment]::GetEnvironmentVariable("Path", "Machine")
    foreach ($d in $p -split ";") {
      if ($d -and (Test-Path -LiteralPath (Join-Path $d "sbx.exe"))) { Join-Path $d "sbx.exe"; break }
    }' | tr -d '\r' || true)"
  if [ -z "$sbx_win" ] || ! mkdir -p "$HOME/.local/bin" ||
    ! ln -sf "$(wslpath "$sbx_win")" "$HOME/.local/bin/sbx.exe"; then
    warn "sbx is installed on Windows, but WSL could not be given a way to run it." \
      "Where Windows' PATH says sbx.exe is: ${sbx_win:-(nowhere)}" \
      "Fix: open a new WSL terminal, so it reads Windows' PATH again, then re-run chezmoi apply."
    failed=1
  fi
fi
{{- end }}

# Both installers exit 0 even when their directory is not on PATH.
for cmd in herdr starship{{ if .chezmoi.kernel.osrelease | lower | contains "microsoft" }} sbx.exe{{ end }}; do
  if [ -z "$failed" ] && ! command -v "$cmd" &>/dev/null; then
    warn "$cmd is still not found on PATH." \
      "Its directory, ~/.local/bin, is not on PATH." \
      "Fix: add it to PATH, then re-run chezmoi apply."
    failed=1
  fi
done

[ -z "$failed" ]
{{ end -}}
