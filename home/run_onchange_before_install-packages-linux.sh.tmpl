{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Runs before the files are placed, so the steps after them find herdr and
# jq. Re-runs only when this script changes, or after a run that failed.
set -euo pipefail
{{ template "warn.sh" . }}
failed=""

if command -v herdr &>/dev/null; then
  echo "herdr already installed. Skipping."
# The official installer: no root, checks the binary's SHA-256, puts it in
# ~/.local/bin (read, 2026-10-08).
elif ! curl -fsSL https://herdr.dev/install.sh | sh; then
  warn "herdr's installer failed." \
    "It said why just above." \
    "Fix: once the reason is gone, re-run chezmoi apply."
  failed=1
fi

if command -v jq &>/dev/null; then
  echo "jq already installed. Skipping."
# apt over a downloaded binary so apt upgrade keeps it current; the cost is
# a sudo password prompt during the run.
elif ! command -v apt-get &>/dev/null; then
  warn "apt-get is not available, so jq was not installed." \
    "Fix: install jq with this system's package manager, then re-run chezmoi apply."
  failed=1
elif ! sudo apt-get install -y jq; then
  warn "sudo apt-get install -y jq failed." \
    "It said why just above (sudo needs a terminal to ask for the password)." \
    "Fix: once the reason is gone, re-run chezmoi apply."
  failed=1
fi

if command -v starship &>/dev/null; then
  echo "starship already installed. Skipping."
# The official installer into ~/.local/bin, beside herdr: its default
# /usr/local/bin needs sudo (read, 2026-10-18).
elif ! mkdir -p "$HOME/.local/bin" ||
  ! curl -fsSL https://starship.rs/install.sh | sh -s -- -y -b "$HOME/.local/bin"; then
  warn "starship's installer failed." \
    "It said why just above." \
    "Fix: once the reason is gone, re-run chezmoi apply."
  failed=1
fi

{{- if .chezmoi.kernel.osrelease | lower | contains "microsoft" }}

# sbx for Linux, inside WSL with the rest of the work. The Windows sbx mounts
# the group at /wsl.localhost/..., where worktrees lose their main repository.
# Docker's apt repository as its Ubuntu steps write it, holding sbx alone as
# on the Mac; get.docker.com would wait 20 seconds on WSL to suggest Docker
# Desktop (read, 2026-10-21).
add_docker_repo() {
  local suite
  suite="$(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")"
  sudo install -m 0755 -d /etc/apt/keyrings &&
    sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc &&
    sudo chmod a+r /etc/apt/keyrings/docker.asc &&
    printf '%s\n' "Types: deb" \
      "URIs: https://download.docker.com/linux/ubuntu" \
      "Suites: $suite" \
      "Components: stable" \
      "Architectures: $(dpkg --print-architecture)" \
      "Signed-By: /etc/apt/keyrings/docker.asc" |
    sudo tee /etc/apt/sources.list.d/docker.sources >/dev/null &&
    sudo apt-get update
}
if command -v sbx &>/dev/null; then
  echo "sbx already installed. Skipping."
elif ! command -v apt-get &>/dev/null; then
  warn "apt-get is not available, so sbx (Docker Sandboxes) was not installed." \
    "Fix: install sbx as https://docs.docker.com/ai/sandboxes/install/ says, then re-run chezmoi apply."
  failed=1
elif ! add_docker_repo || ! sudo apt-get install -y docker-sbx; then
  warn "sbx (Docker Sandboxes) was not installed from Docker's apt repository." \
    "It said why just above." \
    "Fix: once the reason is gone, re-run chezmoi apply."
  failed=1
fi

# Local sandboxes run on KVM, which only the kvm group may open.
if ! id -nG "$USER" | tr ' ' '\n' | grep -qxF kvm &&
  ! sudo usermod -aG kvm "$USER"; then
  warn "sudo usermod -aG kvm $USER failed, so sbx cannot start a sandbox." \
    "It said why just above." \
    "Fix: once the reason is gone, re-run chezmoi apply."
  failed=1
elif ! id -nG | tr ' ' '\n' | grep -qxF kvm; then
  warn "$USER is now in the kvm group, but this terminal started before that." \
    "Fix: open a new WSL terminal, then re-run chezmoi apply."
  failed=1
fi
{{- end }}

# Both installers exit 0 even when their directory is not on PATH.
for cmd in herdr starship; do
  if [ -z "$failed" ] && ! command -v "$cmd" &>/dev/null; then
    warn "$cmd is still not found on PATH." \
      "Its directory, ~/.local/bin, is not on PATH." \
      "Fix: add it to PATH, then re-run chezmoi apply."
    failed=1
  fi
done

[ -z "$failed" ]
{{ end -}}
