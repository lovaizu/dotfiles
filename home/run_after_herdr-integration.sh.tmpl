#!/bin/bash
# The SessionStart key under hooks and the script it calls are herdr's to
# write: `herdr integration install claude` adds the key to the live
# settings.json and places the script. A measurement against an isolated
# home directory showed this. Three real runs reached the same end state with no duplicate entry,
# so the command is idempotent. It runs on every apply, and herdr keeps its
# own hook current.
set -euo pipefail
{{ template "warn.sh" . }}
if ! command -v herdr &>/dev/null; then
  warn "herdr is missing, so its Claude Code SessionStart hook wasn't set up." \
    "Fix: install herdr, then re-run chezmoi apply."
  exit 1
fi
if ! herdr integration install claude; then
  warn "herdr's claude integration wasn't installed." \
    "\`herdr integration install claude\` said why in the preceding output." \
    "Fix: once that reason no longer applies, re-run chezmoi apply."
  exit 1
fi
