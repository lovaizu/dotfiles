{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# sbx asks on its own for what it needs to start (the Docker sign-in, the
# network policy, the credential approval) and Claude asks for /login, but
# nothing asks for the GitHub token: gh inside the sandbox just fails.
set -euo pipefail
{{ template "warn.sh" . }}
if ! command -v sbx &>/dev/null; then
  # The package step already said why.
  exit 0
fi
if ! secrets="$(sbx secret ls 2>&1)"; then
  warn "Could not check whether sbx holds a GitHub token." \
    "sbx secret ls said: $secrets" \
    "Fix: once the reason is gone, re-run chezmoi apply."
  exit 1
fi
if ! grep -qE '^\(global\)[[:space:]]+service[[:space:]]+github[[:space:]]' <<<"$secrets"; then
  warn "sbx holds no GitHub token, so gh inside a sandbox cannot reach GitHub." \
    "The token stays on this Mac; the sandbox only ever sees a placeholder." \
    "Fix: sbx secret set github --command '<a command that prints the token>'," \
    "or sbx secret set github to paste it, then re-run chezmoi apply."
  exit 1
fi
echo "sbx holds a GitHub token."
{{ end -}}
