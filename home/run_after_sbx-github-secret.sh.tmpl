{{- $wsl := and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
{{- if or (eq .chezmoi.os "darwin") $wsl -}}
#!/bin/bash
# sbx asks on its own for what it needs to start: the Docker sign-in, the
# network policy, and the credential approval. Claude asks for /login. But
# nothing asks for the GitHub token, and gh inside the sandbox just fails.
set -euo pipefail
{{ template "warn.sh" . }}
if ! command -v sbx &>/dev/null; then
  # The package step already said why.
  exit 0
fi
if ! secrets="$(sbx secret ls 2>&1)"; then
  warn "This script couldn't check whether sbx holds a GitHub token." \
    "sbx secret ls said: $secrets" \
    "Fix: once that reason no longer applies, re-run chezmoi apply."
  exit 1
fi
if ! grep -qE '^\(global\)[[:space:]]+service[[:space:]]+github[[:space:]]' <<<"$secrets"; then
  # gh's own token, from its browser login, so no one pastes a token, and
  # this repository never keeps it.
  if ! command -v gh &>/dev/null || ! token="$(gh auth token 2>/dev/null)"; then
    warn "sbx holds no GitHub token, so gh inside a sandbox can't reach GitHub." \
      "This script takes it from gh on this machine, and gh isn't logged in here." \
      "Fix: gh auth login, then re-run chezmoi apply."
    exit 1
  fi
  # stdin: the value as of now. After gh logs in again, this script must run
  # again too.
  if ! printf '%s' "$token" | sbx secret set github; then
    warn "sbx secret set github didn't store gh's token." \
      "It said why in the preceding output." \
      "Fix: once that reason no longer applies, re-run chezmoi apply."
    exit 1
  fi
  unset token
fi
echo "sbx holds a GitHub token."
{{ end -}}
