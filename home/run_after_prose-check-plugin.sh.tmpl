#!/bin/bash
# Installs the plugins of this repository's marketplace: prose-check, and
# natural-japanese, the skill that home/dot_claude/CLAUDE.md tells Claude
# Code to follow for Japanese. The hooks of prose-check don't use this copy.
# They run the copy that lovaizu/checks fetches. This script installs the
# plugins with `claude plugin` commands, not in settings.json, for the reason in
# run_after_ccpm-plugin.sh.tmpl.
#
# The marketplace is this clone itself, so Claude Code loads prose-check in
# place from it, and a `git pull` takes effect at the next session.
# natural-japanese is pinned in .claude-plugin/marketplace.json to the commit
# that was read in full before it was installed (lovaizu/dotfiles#57).
set -euo pipefail
{{ template "warn.sh" . }}
clone={{ .chezmoi.workingTree | quote }}
marketplace=dotfiles
plugins=("natural-japanese@$marketplace" "prose-check@$marketplace")
# natural-japanese came from its own marketplace before it was pinned here.
# Two copies would load the skill twice. Removing the marketplace also
# uninstalls its plugin.
old_marketplaces=(natural-japanese)

for cmd in claude jq; do
  if ! command -v "$cmd" &>/dev/null; then
    warn "$cmd is missing, so the plugins of the $marketplace marketplace weren't set up." \
      "Fix: install $cmd, then re-run chezmoi apply."
    exit 1
  fi
done

marketplaces_now="$(claude plugin marketplace list --json 2>/dev/null || echo '[]')"
for name in "${old_marketplaces[@]}"; do
  if echo "$marketplaces_now" | jq -e --arg n "$name" '.[] | select(.name == $n)' >/dev/null &&
    ! claude plugin marketplace remove "$name"; then
    warn "Marketplace $name wasn't removed." \
      "\`claude plugin marketplace remove\` said why in the preceding output." \
      "Fix: once that reason no longer applies, re-run chezmoi apply."
    exit 1
  fi
done

# A marketplace of this name that reads from another directory, such as an
# older clone, is replaced, so that the plugins come from this clone.
if ! echo "$marketplaces_now" | jq -e --arg n "$marketplace" --arg p "$clone" \
  '.[] | select(.name == $n and .path == $p)' >/dev/null; then
  if echo "$marketplaces_now" | jq -e --arg n "$marketplace" '.[] | select(.name == $n)' >/dev/null &&
    ! claude plugin marketplace remove "$marketplace"; then
    warn "Marketplace $marketplace wasn't removed, so Claude Code couldn't read it from $clone." \
      "\`claude plugin marketplace remove\` said why in the preceding output." \
      "Fix: once that reason no longer applies, re-run chezmoi apply."
    exit 1
  fi
  if ! claude plugin marketplace add "$clone"; then
    warn "Marketplace $marketplace wasn't added from $clone." \
      "\`claude plugin marketplace add\` said why in the preceding output." \
      "Fix: once that reason no longer applies, re-run chezmoi apply."
    exit 1
  fi
fi

# A plugin installed at a commit other than the pinned one is installed
# again. `claude plugin update` is not used: it clones over SSH, which fails
# where no SSH key is set up, while `install` falls back to HTTPS.
installed="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json"
for plugin_id in "${plugins[@]}"; do
  pinned="$(jq -r --arg n "${plugin_id%@*}" \
    '.plugins[] | select(.name == $n) | .source.sha? // empty' "$clone/.claude-plugin/marketplace.json")"
  now="$(jq -r --arg id "$plugin_id" '.plugins[$id][0].gitCommitSha // empty' "$installed" 2>/dev/null || true)"
  if [ -n "$pinned" ] && [ -n "$now" ] && [ "$pinned" != "$now" ] &&
    ! claude plugin uninstall "$plugin_id"; then
    warn "Plugin $plugin_id wasn't uninstalled, so it stays at commit $now, not $pinned." \
      "\`claude plugin uninstall\` said why in the preceding output." \
      "Fix: once that reason no longer applies, re-run chezmoi apply."
    exit 1
  fi
  # On a plugin that is there, `install` says so and exits 0.
  if ! claude plugin install "$plugin_id" -y; then
    warn "Plugin $plugin_id wasn't installed." \
      "\`claude plugin install\` said why in the preceding output." \
      "Fix: once that reason no longer applies, re-run chezmoi apply."
    exit 1
  fi
done
