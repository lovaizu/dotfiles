#!/bin/sh
# Opens herdr inside the Docker Sandbox of the ~/work group this directory
# belongs to, creating the sandbox on first use.
set -eu

# The kit in the clone ./setup.sh applied, so it changes with git pull and
# ./setup.sh like everything else here.
kit={{ joinPath .chezmoi.workingTree "sbx" | quote }}
work="$HOME/work"

stop() {
  echo >&2
  echo "sb: didn't start anything." >&2
  for line in "$@"; do
    echo "  $line" >&2
  done
  echo >&2
  exit 1
}

if [ -n "${HERDR_ENV:-}" ]; then
  stop "This shell already runs inside herdr, and opening the sandbox's" \
    "herdr here would put one herdr inside another." \
    "Fix: run sb from a terminal tab that is not running herdr."
fi

if ! command -v sbx >/dev/null; then
  stop "sbx (Docker Sandboxes) is not found." \
    "Fix: run ./setup.sh in the dotfiles clone; it installs sbx."
fi

if ! command -v jq >/dev/null; then
  stop "jq is not found, and sb needs it to read the status of the sandbox." \
    "Fix: run ./setup.sh in the dotfiles clone; it installs jq with mise."
fi

# The physical paths, so a symlink on either side can't hide a match.
here="$(pwd -P)"
if ! work_real="$(cd "$work" 2>/dev/null && pwd -P)"; then
  stop "$work does not exist, so there is no group to open." \
    "Fix: put the repositories in a group directory such as $work/<group>," \
    "then run sb from inside it."
fi

# sb mounts the whole group, never the directory that it started in: one
# group then shares one sandbox, and a worktree still reaches its main
# repository's .git. Outside a group sb mounts nothing, so it never mounts
# `$HOME`.
case "$here/" in
"$work_real"/?*/)
  group="${here#"$work_real"/}"
  group="${group%%/*}"
  ;;
*)
  stop "$here is not inside a group directory under $work." \
    "sb mounts the whole group into the sandbox, and here there is no" \
    "group, so it stops rather than mount this directory or \$HOME." \
    "Fix: cd into $work/<group> or anywhere below it, then run sb again."
  ;;
esac

# The kit's startup command, which pulls main of the dotfiles, runs only
# when a sandbox starts, and sbx run only reconnects to a running sandbox.
# So sb stops a running sandbox first, and the start runs the command again.
# sb knows only the status "running" of sbx ls, so it leaves a sandbox with
# any other status alone.
status="$(sbx ls --json | jq -r --arg name "$group" \
  '.[] | select(.name == $name) | .status')"
if [ "$status" = running ]; then
  if ! sbx stop "$group"; then
    stop "sbx stop $group failed, so the sandbox can't restart and pull main" \
      "of the dotfiles." \
      "Fix: read the error above, then run sb again."
  fi
fi
if [ -n "$status" ]; then
  exec sbx run --name "$group"
fi
exec sbx run --name "$group" "$kit" "$work_real/$group"
