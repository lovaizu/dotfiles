{
  "permissions": {
    "additionalDirectories": [
      "~/.claude/plugins/cache"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"$HOME/.claude/scripts/statusline.sh\""
  },
  "enabledPlugins": {
    "rn@ccpm": true
  },
  "extraKnownMarketplaces": {
    "ccpm": {
      "source": {
        "source": "github",
        "repo": "lovaizu/ccpm"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "auto",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
